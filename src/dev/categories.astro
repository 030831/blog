---
/**
 * 카테고리 관리 화면. 개발 서버에서만 열립니다.
 * 추가 / 이름 바꾸기 / 삭제를 하고, 폴더와 src/config.ts 를 함께 고칩니다.
 */
import '../styles/global.css';

const isDev = import.meta.env.DEV;
---

<!doctype html>
<html lang="ko" data-skin="warm" data-theme="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>카테고리 관리 — 030831</title>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  </head>

  <body>
    {!isDev ? (
      <div class="wrap"><p>개발 서버에서만 열립니다.</p></div>
    ) : (
      <div class="wrap">
        <header class="head">
          <a href="/categories" class="back">← 카테고리</a>
          <h1>카테고리 관리</h1>
          <p class="lead">
            폴더가 곧 카테고리입니다. 여기서 바꾸면 폴더와 <code>src/config.ts</code> 가 함께 고쳐집니다.
            글 주소는 번호라서 카테고리를 옮겨도 링크가 깨지지 않습니다.
          </p>
        </header>

        <section class="panel">
          <h2>새 카테고리</h2>
          <form id="add-form" class="row">
            <label>
              <span>폴더 이름</span>
              <input id="add-path" type="text" placeholder="backend/mysql" autocomplete="off" required />
            </label>
            <label>
              <span>보이는 이름</span>
              <input id="add-label" type="text" placeholder="MySQL" autocomplete="off" />
            </label>
            <button type="submit" class="btn primary">추가</button>
          </form>
        </section>

        <section class="panel">
          <h2>목록</h2>
          <p id="empty" class="empty" hidden>아직 카테고리가 없습니다.</p>
          <ul id="list" class="list"></ul>
        </section>

        <p id="status" class="status" role="status"></p>
      </div>
    )}

    <style is:global>
      .wrap { max-width: 44rem; margin-inline: auto; padding: 3rem 1.5rem 5rem; }

      .head { margin-bottom: 2rem; }
      .back { font-size: .85rem; color: var(--text-muted); }
      .back:hover { color: var(--accent); }
      .head h1 { margin: .6rem 0 0; font-size: 1.8rem; font-weight: 800; letter-spacing: -0.03em; }
      .lead { margin: .7rem 0 0; color: var(--text-muted); font-size: .9rem; line-height: 1.7; }
      .lead code {
        font-family: var(--font-mono);
        font-size: .875em;
        background: var(--bg-subtle);
        border: 1px solid var(--border);
        border-radius: 4px;
        padding: .1em .35em;
      }

      .panel {
        padding: 1.4rem 1.5rem;
        margin-bottom: 1.25rem;
        background: var(--surface);
        border: 1px solid var(--border);
        border-radius: var(--radius);
      }
      .panel h2 {
        margin: 0 0 1rem;
        font-size: .78rem;
        font-weight: 700;
        letter-spacing: .08em;
        text-transform: uppercase;
        color: var(--text-faint);
      }

      .row { display: flex; gap: .7rem; align-items: flex-end; flex-wrap: wrap; }
      .row label { display: grid; gap: .3rem; flex: 1; min-width: 10rem; }
      .row span { font-size: .78rem; color: var(--text-faint); }

      input[type='text'] {
        width: 100%;
        padding: .5rem .7rem;
        border: 1px solid var(--border);
        border-radius: 7px;
        background: var(--bg);
        font-family: var(--font-sans);
        font-size: .875rem;
        color: var(--text);
      }
      input[type='text']:focus {
        outline: none;
        border-color: var(--accent);
        box-shadow: 0 0 0 3px color-mix(in srgb, var(--accent) 14%, transparent);
      }

      .btn {
        padding: .5rem 1.1rem;
        border: 1px solid transparent;
        border-radius: 7px;
        font-family: var(--font-sans);
        font-size: .85rem;
        font-weight: 700;
        cursor: pointer;
        transition: background .18s ease, color .18s ease, border-color .18s ease;
      }
      .btn.primary { background: var(--accent); color: #fff; }
      .btn.primary:hover { filter: brightness(1.08); }
      .btn.ghost { background: none; color: var(--text-muted); border-color: var(--border-strong); }
      .btn.ghost:hover { color: var(--text); border-color: var(--text-muted); }
      .btn.danger { background: none; color: #c0392b; border-color: #e3b5ae; }
      .btn.danger:hover { background: #fdecea; border-color: #c0392b; }
      .btn.small { padding: .32rem .7rem; font-size: .78rem; font-weight: 600; }

      .list { list-style: none; margin: 0; padding: 0; }
      .list li {
        display: flex;
        align-items: center;
        gap: .7rem;
        padding: .7rem 0;
        border-bottom: 1px solid var(--border);
        flex-wrap: wrap;
      }
      .list li:last-child { border-bottom: 0; }

      .cat-path {
        font-family: var(--font-mono);
        font-size: .8rem;
        color: var(--text-faint);
        min-width: 11rem;
      }
      .cat-label { font-weight: 600; font-size: .95rem; }
      .cat-count { font-size: .75rem; color: var(--text-faint); }
      .cat-actions { margin-left: auto; display: flex; gap: .4rem; }

      .empty { color: var(--text-muted); font-size: .9rem; margin: 0; }

      .status { margin-top: 1.25rem; font-size: .85rem; color: var(--text-muted); min-height: 1.2em; }
      .status.ok { color: var(--accent); }
      .status.error { color: #c0392b; }
    </style>

    <script>
      const list = document.getElementById('list');
      const empty = document.getElementById('empty');
      const status = document.getElementById('status');

      if (list && empty && status) {
        const setStatus = (message: string, kind: '' | 'ok' | 'error' = '') => {
          status.textContent = message;
          status.className = `status ${kind}`;
        };

        const manage = async (body: Record<string, unknown>) => {
          const response = await fetch('/api/manage', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(body),
          });
          return { ok: response.ok, data: await response.json() };
        };

        const render = async () => {
          const { ok, data } = await manage({ action: 'list-categories' });
          if (!ok) return setStatus(data.error ?? '목록을 불러오지 못했습니다.', 'error');

          const categories = data.categories as { path: string; label: string; count: number }[];
          empty.hidden = categories.length > 0;
          list.innerHTML = '';

          for (const category of categories) {
            const li = document.createElement('li');

            const path = document.createElement('span');
            path.className = 'cat-path';
            path.textContent = category.path;

            const label = document.createElement('span');
            label.className = 'cat-label';
            label.textContent = category.label;

            const count = document.createElement('span');
            count.className = 'cat-count';
            count.textContent = `글 ${category.count}개`;

            const actions = document.createElement('div');
            actions.className = 'cat-actions';

            const renameButton = document.createElement('button');
            renameButton.className = 'btn ghost small';
            renameButton.textContent = '이름 바꾸기';
            renameButton.addEventListener('click', () => rename(category));

            const deleteButton = document.createElement('button');
            deleteButton.className = 'btn danger small';
            deleteButton.textContent = '삭제';
            deleteButton.addEventListener('click', () => remove(category));

            actions.append(renameButton, deleteButton);
            li.append(path, label, count, actions);
            list.append(li);
          }
        };

        const rename = async (category: { path: string; label: string }) => {
          const label = prompt('보이는 이름', category.label);
          if (label === null) return;
          const newPath = prompt('폴더 이름 (그대로 두려면 확인)', category.path);
          if (newPath === null) return;

          setStatus('바꾸는 중…');
          const { ok, data } = await manage({
            action: 'rename-category',
            path: category.path,
            label,
            newPath,
          });
          if (!ok) return setStatus(data.error ?? '바꾸지 못했습니다.', 'error');

          setStatus(`바뀌었습니다: ${data.path}`, 'ok');
          render();
        };

        const remove = async (category: { path: string; count: number }) => {
          if (!confirm(`'${category.path}' 카테고리를 삭제할까요?`)) return;

          setStatus('삭제 중…');
          const { ok, data } = await manage({ action: 'delete-category', path: category.path });
          if (!ok) return setStatus(data.error ?? '삭제하지 못했습니다.', 'error');

          setStatus('삭제되었습니다.', 'ok');
          render();
        };

        document.getElementById('add-form')?.addEventListener('submit', async (event) => {
          event.preventDefault();
          const pathInput = document.getElementById('add-path') as HTMLInputElement;
          const labelInput = document.getElementById('add-label') as HTMLInputElement;

          setStatus('추가하는 중…');
          const { ok, data } = await manage({
            action: 'add-category',
            path: pathInput.value.trim(),
            label: labelInput.value.trim(),
          });
          if (!ok) return setStatus(data.error ?? '추가하지 못했습니다.', 'error');

          pathInput.value = '';
          labelInput.value = '';
          setStatus(`추가되었습니다: ${data.path}`, 'ok');
          render();
        });

        render();
      }
    </script>
  </body>
</html>
