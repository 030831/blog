---
import FormattedDate from './FormattedDate.astro';
import { categoryOf, excerptOf, urlOf, type Post } from '../lib/posts';
import { labelOf, urlOfCategory } from '../lib/categories';

interface Props { post: Post; }
const { post } = Astro.props;

const category = categoryOf(post);
const href = urlOf(post);
---

<article class="card">
  <!-- 카테고리를 제목 위 작은 라벨로 올려 글의 소속을 먼저 알립니다. -->
  {category && (
    <a href={urlOfCategory(category)} class="kicker">{labelOf(category)}</a>
  )}

  <h2 class="title">
    <a href={href}>{post.data.title}</a>
  </h2>

  <p class="excerpt">{excerptOf(post)}</p>

  <div class="foot">
    <time class="date" datetime={post.data.date.toISOString()}>
      <FormattedDate date={post.data.date} />
    </time>

    <a href={href} class="more">
      더 읽어보기
      <svg viewBox="0 0 16 16" width="12" height="12" aria-hidden="true">
        <path d="M3 8h9M8.4 4.2 12.2 8l-3.8 3.8" fill="none" stroke="currentColor"
              stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" />
      </svg>
    </a>
  </div>
</article>

<style>
  .card {
    position: relative;
    padding: 1.6rem 1.75rem 1.35rem;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    transition: border-color .22s ease, box-shadow .22s ease, transform .22s ease;
  }
  .card:hover {
    border-color: var(--border-strong);
    box-shadow: 0 8px 26px color-mix(in srgb, var(--text) 7%, transparent);
    transform: translateY(-2px);
  }

  /* ── 카테고리 라벨 ── */
  .kicker {
    display: inline-block;
    margin-bottom: .55rem;
    font-size: .72rem;
    font-weight: 700;
    letter-spacing: .07em;
    color: var(--accent);
    transition: opacity .18s ease;
  }
  .kicker:hover { opacity: .7; text-decoration: underline; text-underline-offset: 3px; }

  /* ── 제목: 본문과 확실히 차이 나는 크기로 ── */
  .title {
    margin: 0;
    font-size: 1.4rem;
    font-weight: 700;
    line-height: 1.4;
    letter-spacing: -0.03em;
  }
  .title a {
    background-image: linear-gradient(var(--accent), var(--accent));
    background-repeat: no-repeat;
    background-position: 0 100%;
    background-size: 0% 1.5px;
    transition: background-size .32s ease, color .2s ease;
    padding-bottom: 1px;
  }
  .card:hover .title a { color: var(--accent); background-size: 100% 1.5px; }

  .excerpt {
    margin: .7rem 0 0;
    font-size: .92rem;
    line-height: 1.78;
    color: var(--text-muted);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  /* ── 바닥: 날짜와 링크를 양 끝으로 ── */
  .foot {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-top: 1.2rem;
    padding-top: .9rem;
    border-top: 1px solid var(--border);
  }

  .date {
    font-size: .78rem;
    color: var(--text-faint);
    font-variant-numeric: tabular-nums;
  }

  /* 알약 버튼 대신 글자 링크로 두어 카드 안에서 튀지 않게 합니다. */
  .more {
    display: inline-flex;
    align-items: center;
    gap: .32rem;
    font-size: .82rem;
    font-weight: 600;
    color: var(--text-muted);
    transition: color .18s ease;
  }
  .more svg { transition: transform .24s cubic-bezier(.34, 1.3, .64, 1); }
  .more:hover { color: var(--accent); }
  .card:hover .more { color: var(--accent); }
  .card:hover .more svg { transform: translateX(3px); }

  @media (prefers-reduced-motion: reduce) {
    .card:hover { transform: none; }
    .card:hover .more svg { transform: none; }
  }

  @media (max-width: 34rem) {
    .card { padding: 1.35rem 1.25rem 1.15rem; }
    .title { font-size: 1.22rem; }
  }
</style>
