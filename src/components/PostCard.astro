---
import FormattedDate from './FormattedDate.astro';
import { categoryOf, excerptOf, urlOf, type Post } from '../lib/posts';
import { labelOf, urlOfCategory } from '../lib/categories';

interface Props { post: Post; }
const { post } = Astro.props;

const category = categoryOf(post);
const href = urlOf(post);
---

<article class="card">
  <h2 class="title">
    <a href={href}>{post.data.title}</a>
  </h2>

  <div class="meta">
    <span class="meta-item">
      <svg viewBox="0 0 16 16" width="13" height="13" aria-hidden="true">
        <rect x="2" y="3.2" width="12" height="11" rx="1.6" fill="none"
              stroke="currentColor" stroke-width="1.3" />
        <path d="M2 6.6h12M5.5 1.8v2.6M10.5 1.8v2.6" fill="none"
              stroke="currentColor" stroke-width="1.3" stroke-linecap="round" />
      </svg>
      <FormattedDate date={post.data.date} />
    </span>

    {category && (
      <span class="meta-item">
        <svg viewBox="0 0 16 16" width="13" height="13" aria-hidden="true">
          <path d="M1.8 4.2a1.4 1.4 0 0 1 1.4-1.4h2.7l1.5 1.8h5.4a1.4 1.4 0 0 1 1.4 1.4v6.4a1.4 1.4 0 0 1-1.4 1.4H3.2a1.4 1.4 0 0 1-1.4-1.4Z"
                fill="none" stroke="currentColor" stroke-width="1.3" stroke-linejoin="round" />
        </svg>
        <a href={urlOfCategory(category)} class="cat-link">{labelOf(category)}</a>
      </span>
    )}
  </div>

  <p class="excerpt">{excerptOf(post)}</p>

  <a href={href} class="more">
    더 읽어보기
    <svg viewBox="0 0 16 16" width="13" height="13" aria-hidden="true">
      <path d="M3 8h9M8.4 4.2 12.2 8l-3.8 3.8" fill="none" stroke="currentColor"
            stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
    </svg>
  </a>
</article>

<style>
  .card {
    position: relative;
    padding: 1.75rem 1.9rem 1.6rem;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    /* 그림자와 이동을 함께 다뤄 카드가 살짝 떠오르는 느낌을 만듭니다. */
    transition:
      border-color .22s ease,
      box-shadow .22s ease,
      transform .22s ease;
  }
  .card:hover {
    border-color: var(--border-strong);
    box-shadow: 0 6px 22px color-mix(in srgb, var(--text) 8%, transparent);
    transform: translateY(-3px);
  }

  /* 왼쪽에 강조선이 자라나는 효과. 카드가 눌리는 대상임을 알려줍니다. */
  .card::before {
    content: '';
    position: absolute;
    left: -1px;
    top: 1.2rem;
    bottom: 1.2rem;
    width: 3px;
    border-radius: 3px;
    background: var(--accent);
    transform: scaleY(0);
    transform-origin: center;
    transition: transform .28s cubic-bezier(.34, 1.4, .64, 1);
  }
  .card:hover::before { transform: scaleY(1); }

  .title {
    margin: 0;
    font-size: 1.28rem;
    font-weight: 700;
    line-height: 1.45;
    letter-spacing: -0.025em;
  }
  .title a {
    /* 밑줄이 왼쪽에서 오른쪽으로 그어지는 효과 */
    background-image: linear-gradient(var(--accent), var(--accent));
    background-repeat: no-repeat;
    background-position: 0 100%;
    background-size: 0% 1.5px;
    transition: background-size .3s ease, color .2s ease;
    padding-bottom: 2px;
  }
  .card:hover .title a { color: var(--accent); background-size: 100% 1.5px; }

  .meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: .4rem 1.15rem;
    margin-top: .8rem;
    font-size: .8rem;
    color: var(--text-faint);
  }
  .meta-item { display: inline-flex; align-items: center; gap: .35rem; }
  .meta svg { flex-shrink: 0; opacity: .8; }

  .cat-link { color: var(--text-muted); transition: color .18s ease; }
  .cat-link:hover { color: var(--accent); text-decoration: underline; text-underline-offset: 3px; }

  .excerpt {
    margin: 1rem 0 0;
    font-size: .935rem;
    line-height: 1.72;
    color: var(--text-muted);
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .more {
    display: inline-flex;
    align-items: center;
    gap: .4rem;
    margin-top: 1.3rem;
    padding: .48rem 1rem;
    font-size: .85rem;
    font-weight: 600;
    color: var(--text);
    border: 1px solid var(--border-strong);
    border-radius: 999px;
    transition:
      background .22s ease,
      color .22s ease,
      border-color .22s ease,
      box-shadow .22s ease;
  }
  .more svg { transition: transform .25s cubic-bezier(.34, 1.3, .64, 1); }
  .more:hover {
    color: #fff;
    background: var(--accent);
    border-color: var(--accent);
    box-shadow: 0 4px 14px color-mix(in srgb, var(--accent) 32%, transparent);
  }
  .more:hover svg { transform: translateX(3px); }
  .more:active { transform: translateY(1px); }

  @media (prefers-reduced-motion: reduce) {
    .card, .card::before, .title a, .more, .more svg { transition: none; }
    .card:hover { transform: none; }
  }

  @media (max-width: 34rem) {
    .card { padding: 1.4rem 1.3rem 1.3rem; }
    .title { font-size: 1.15rem; }
  }
</style>
