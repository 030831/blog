---
import FormattedDate from './FormattedDate.astro';
import type { Post } from '../lib/posts';

interface Props { post: Post; }
const { post } = Astro.props;
---

<article class="card">
  <a href={`/posts/${post.id}/`} class="title-link">
    <h2>{post.data.title}</h2>
  </a>

  {post.data.description && <p class="desc">{post.data.description}</p>}

  <div class="meta">
    <FormattedDate date={post.data.date} />
    {post.data.tags.length > 0 && (
      <ul class="tags">
        {post.data.tags.map((tag) => (
          <li><a href={`/tags/${encodeURIComponent(tag)}/`}>#{tag}</a></li>
        ))}
      </ul>
    )}
  </div>
</article>

<style>
  .card { padding-block: 1.75rem; border-bottom: 1px solid var(--border); }
  .card:last-child { border-bottom: 0; }

  h2 {
    margin: 0;
    font-size: 1.25rem;
    font-weight: 700;
    line-height: 1.4;
    letter-spacing: -0.02em;
    transition: color .15s;
  }
  .title-link:hover h2 { color: var(--accent); }

  .desc {
    margin: .5rem 0 0;
    color: var(--text-muted);
    font-size: .9375rem;
    line-height: 1.65;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: .5rem 1rem;
    margin-top: .85rem;
    font-size: .8125rem;
    color: var(--text-faint);
  }
  .tags { display: flex; flex-wrap: wrap; gap: .5rem; list-style: none; margin: 0; padding: 0; }
  .tags a { transition: color .15s; }
  .tags a:hover { color: var(--accent); }
</style>
