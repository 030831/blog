---
// 제목과 날짜만 보여주는 압축 목록 행. 글이 많은 화면에서 씁니다.
import FormattedDate from './FormattedDate.astro';
import { urlOf, type Post } from '../lib/posts';

interface Props { post: Post; }
const { post } = Astro.props;
---

<li class="row">
  <a href={urlOf(post)}>
    <span class="title">{post.data.title}</span>
    <span class="date"><FormattedDate date={post.data.date} /></span>
  </a>
</li>

<style>
  .row { border-bottom: 1px solid var(--border); }
  .row:last-child { border-bottom: 0; }

  a {
    position: relative;
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1.5rem;
    padding: .95rem 1rem .95rem .9rem;
    border-radius: var(--radius-sm);
    transition: background .2s ease, padding-left .22s ease;
  }
  a:hover { background: var(--bg-subtle); padding-left: 1.35rem; }

  /* 왼쪽에서 강조선이 밀려 들어옵니다. */
  a::before {
    content: '';
    position: absolute;
    left: .35rem;
    top: 50%;
    width: 3px;
    height: 0;
    border-radius: 3px;
    background: var(--accent);
    transform: translateY(-50%);
    transition: height .24s cubic-bezier(.34, 1.3, .64, 1);
  }
  a:hover::before { height: 1.15rem; }

  .title {
    line-height: 1.5;
    font-size: .98rem;
    transition: color .18s ease;
  }
  a:hover .title { color: var(--accent); }

  .date {
    flex-shrink: 0;
    font-size: .8rem;
    color: var(--text-faint);
    font-variant-numeric: tabular-nums;
    transition: color .18s ease;
  }
  a:hover .date { color: var(--text-muted); }

  @media (prefers-reduced-motion: reduce) {
    a:hover { padding-left: .9rem; }
  }

  @media (max-width: 34rem) {
    a { flex-direction: column; gap: .2rem; }
    a:hover { padding-left: 1.1rem; }
  }
</style>
