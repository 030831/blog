---
import { breadcrumbOf, urlOfCategory, type CategoryNode } from '../lib/categories';

interface Props {
  nodes: CategoryNode[];
  /** 현재 보고 있는 카테고리 경로. 해당 항목이 강조됩니다. */
  current?: string;
}

const { nodes, current = '' } = Astro.props;

/** 하위 전체를 한 줄로 펼칩니다. 깊이 순서를 유지해 위계가 읽히도록 합니다. */
function descendantsOf(node: CategoryNode): CategoryNode[] {
  return node.children.flatMap((child) => [child, ...descendantsOf(child)]);
}

/**
 * 최상위를 뺀 나머지 경로 이름들.
 * 'backend/spring/jpa' 를 backend 아래에서 보면 ['Spring', 'JPA'] 가 됩니다.
 * 들여쓰기 대신 이 경로를 그대로 보여줘서 깊이가 깊어져도 자리를 더 먹지 않습니다.
 */
function relativeLabels(path: string): string[] {
  return breadcrumbOf(path).slice(1).map((step) => step.label);
}

const rows = nodes.map((root) => ({ root, descendants: descendantsOf(root) }));
---

<div class="grid">
  {rows.map(({ root, descendants }) => (
    <>
      <a
        href={urlOfCategory(root.path)}
        class:list={['root', { current: current === root.path }]}
        aria-current={current === root.path ? 'page' : undefined}
      >
        <span class="label">{root.label}</span>
        <span class="n">{root.totalCount}</span>
      </a>

      <div class="branch">
        {descendants.map((node) => (
          <a
            href={urlOfCategory(node.path)}
            class:list={['leaf', { current: current === node.path }]}
            aria-current={current === node.path ? 'page' : undefined}
          >
            {relativeLabels(node.path).map((label, i) => (
              <>
                {i > 0 && <span class="sep" aria-hidden="true">›</span>}
                <span class="seg">{label}</span>
              </>
            ))}
            <span class="n">{node.totalCount}</span>
          </a>
        ))}
      </div>
    </>
  ))}
</div>

<style>
  /*
   * 최상위는 왼쪽 열에 세로로 줄을 맞추고, 하위는 오른쪽에서 가로로 흐릅니다.
   * 하위가 많아지면 아래로 접히기만 하므로, 트리가 복잡해져도
   * 들여쓰기가 누적되거나 가로 스크롤이 생기지 않습니다.
   */
  .grid {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: .3rem 1.1rem;
    align-items: start;
  }

  /* ── 왼쪽: 최상위 카테고리 ── */
  .root {
    display: inline-flex;
    align-items: center;
    gap: .4rem;
    padding: .34rem .85rem;
    border-radius: 999px;
    background: var(--bg-subtle);
    font-size: .92rem;
    font-weight: 700;
    letter-spacing: -0.01em;
    white-space: nowrap;
    transition: color .18s ease, background .18s ease, box-shadow .18s ease;
  }
  .root:hover { color: var(--accent); background: var(--accent-soft); }
  .root.current {
    color: var(--bg);
    background: var(--text);
  }

  /* ── 오른쪽: 하위 카테고리들 ── */
  .branch {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: .3rem .45rem;
    min-height: 2rem;
    padding-top: .1rem;
  }

  .leaf {
    display: inline-flex;
    align-items: center;
    gap: .3rem;
    padding: .26rem .7rem;
    border-radius: 999px;
    font-size: .84rem;
    color: var(--text-muted);
    transition: color .18s ease, background .18s ease;
  }
  .leaf:hover { color: var(--accent); background: var(--accent-soft); }
  .leaf.current { color: var(--accent); background: var(--accent-soft); font-weight: 600; }

  /* 경로가 깊어지면 앞쪽 조각을 흐리게 해서 마지막 이름이 눈에 들어오게 합니다. */
  .seg { color: inherit; }
  .leaf .seg:not(:last-of-type) { color: var(--text-faint); }
  .sep { color: var(--text-faint); font-size: .78em; margin-inline: .05rem; }

  .n {
    font-size: .68rem;
    color: var(--text-faint);
    font-variant-numeric: tabular-nums;
  }
  .root .n { color: inherit; opacity: .6; }

  /* 좁은 화면에서는 최상위와 하위를 위아래로 쌓습니다. */
  @media (max-width: 36rem) {
    .grid { grid-template-columns: 1fr; gap: .2rem; }
    .branch { padding: 0 0 .8rem .6rem; min-height: 0; }
  }
</style>
