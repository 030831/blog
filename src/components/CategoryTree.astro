---
import { breadcrumbOf, urlOfCategory, type CategoryNode } from '../lib/categories';

interface Props {
  nodes: CategoryNode[];
  /** 현재 보고 있는 카테고리 경로. 해당 항목이 강조됩니다. */
  current?: string;
}

const { nodes, current = '' } = Astro.props;

/** 하위 전체를 한 줄로 펼칩니다. 깊이 순서를 유지해 위계가 읽히도록 합니다. */
function descendantsOf(node: CategoryNode): CategoryNode[] {
  return node.children.flatMap((child) => [child, ...descendantsOf(child)]);
}

/**
 * 최상위를 뺀 나머지 경로 이름들.
 * 'backend/spring/jpa' 를 backend 아래에서 보면 ['Spring', 'JPA'] 가 됩니다.
 * 들여쓰기 대신 경로를 그대로 보여줘서 깊어져도 자리를 더 먹지 않습니다.
 */
function relativeLabels(path: string): string[] {
  return breadcrumbOf(path).slice(1).map((step) => step.label);
}

const rows = nodes.map((root) => ({ root, descendants: descendantsOf(root) }));
---

<ul class="list">
  {rows.map(({ root, descendants }) => (
    <li class="row">
      <a
        href={urlOfCategory(root.path)}
        class:list={['root', { current: current === root.path }]}
        aria-current={current === root.path ? 'page' : undefined}
      >
        <span class="name">{root.label}</span>
        <span class="count">{root.totalCount}</span>
      </a>

      {descendants.length > 0 && (
        <div class="children">
          {descendants.map((node) => (
            <a
              href={urlOfCategory(node.path)}
              class:list={['child', { current: current === node.path }]}
              aria-current={current === node.path ? 'page' : undefined}
            >
              {relativeLabels(node.path).map((label, i) => (
                <>
                  {i > 0 && <span class="sep" aria-hidden="true">›</span>}
                  <span class="seg">{label}</span>
                </>
              ))}
              <span class="n">{node.totalCount}</span>
            </a>
          ))}
        </div>
      )}
    </li>
  ))}
</ul>

<style>
  /*
   * 각 최상위 카테고리가 한 행을 차지하고, 행은 가로 폭을 끝까지 씁니다.
   * 2열 격자로 만들었더니 카테고리가 적을 때 오른쪽이 텅 비어
   * 표가 깨진 것처럼 보여서 이 구조로 바꿨습니다.
   * 하위는 행 아래에 가로로 흐르다 넘치면 접힙니다.
   */
  .list { list-style: none; margin: 0; padding: 0; }

  .row { border-bottom: 1px solid var(--border); }
  .row:last-child { border-bottom: 0; }

  /* ── 최상위: 이름은 왼쪽, 개수는 오른쪽 끝 ── */
  .root {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    padding: .8rem .7rem;
    border-radius: var(--radius-sm);
    transition: color .18s ease, background .18s ease, padding-left .2s ease;
  }
  .root:hover { background: var(--bg-subtle); padding-left: 1.05rem; }
  .root:hover .name { color: var(--accent); }

  .name {
    font-size: 1rem;
    font-weight: 700;
    letter-spacing: -0.015em;
    transition: color .18s ease;
  }
  .count {
    flex-shrink: 0;
    font-size: .78rem;
    color: var(--text-faint);
    font-variant-numeric: tabular-nums;
  }
  .root.current .name { color: var(--accent); }

  /* ── 하위: 작은 알약으로 가로 흐름 ── */
  .children {
    display: flex;
    flex-wrap: wrap;
    gap: .3rem .4rem;
    padding: 0 .7rem .85rem 1.1rem;
  }

  .child {
    display: inline-flex;
    align-items: center;
    gap: .3rem;
    padding: .22rem .65rem;
    border: 1px solid var(--border);
    border-radius: 999px;
    font-size: .82rem;
    color: var(--text-muted);
    transition: color .18s ease, background .18s ease, border-color .18s ease;
  }
  .child:hover {
    color: var(--accent);
    background: var(--accent-soft);
    border-color: var(--accent);
  }
  .child.current {
    color: var(--accent);
    background: var(--accent-soft);
    border-color: var(--accent);
    font-weight: 600;
  }

  /* 경로가 깊어지면 앞쪽 조각을 흐리게 해 마지막 이름이 먼저 읽히게 합니다. */
  .child .seg:not(:last-of-type) { color: var(--text-faint); }
  .sep { color: var(--text-faint); font-size: .78em; margin-inline: .04rem; }

  .n { font-size: .68rem; color: var(--text-faint); font-variant-numeric: tabular-nums; }

  @media (prefers-reduced-motion: reduce) {
    .root:hover { padding-left: .7rem; }
  }

  @media (max-width: 34rem) {
    .children { padding-left: .9rem; }
  }
</style>
