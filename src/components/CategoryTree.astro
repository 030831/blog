---
import type { CategoryNode } from '../lib/categories';
import { urlOfCategory } from '../lib/categories';

interface Props {
  nodes: CategoryNode[];
  /** 현재 열려 있는 카테고리 경로. 이 경로 위의 항목들이 자동으로 펼쳐집니다. */
  current?: string;
}

const { nodes, current = '' } = Astro.props;

const isCurrent = (path: string) => current === path;
const isAncestor = (path: string) => current.startsWith(path + '/');

/**
 * 깊이에 따른 들여쓰기(rem).
 *
 * 단계마다 같은 폭으로 들여쓰면 4단계쯤에서 글자가 들어갈 자리가 없어집니다.
 * 그래서 깊어질수록 증가폭을 줄입니다: 0 → 0.75 → 1.35 → 1.8 → 2.15 ...
 */
function indentOf(depth: number): number {
  let indent = 0;
  let step = 0.75;
  for (let d = 1; d < depth; d++) {
    indent += step;
    step = Math.max(step * 0.8, 0.35);
  }
  return Number(indent.toFixed(2));
}
---

<ul>
  {nodes.map((node) => {
    const hasChildren = node.children.length > 0;
    // 현재 보고 있는 카테고리로 가는 길목은 펼친 채로 시작합니다.
    const expanded = isCurrent(node.path) || isAncestor(node.path);

    return (
      <li class="item" data-path={node.path} data-has-children={hasChildren ? 'true' : 'false'}>
        <div class="row" style={`--indent: ${indentOf(node.depth)}rem`}>
          {hasChildren ? (
            <button
              class="caret"
              type="button"
              aria-expanded={expanded ? 'true' : 'false'}
              aria-label={`${node.label} 하위 항목 펼치기/접기`}
            >
              <svg viewBox="0 0 12 12" width="10" height="10" aria-hidden="true">
                <path d="M4 2.5 L8 6 L4 9.5" fill="none" stroke="currentColor"
                      stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            </button>
          ) : (
            <span class="caret caret--empty" aria-hidden="true"></span>
          )}

          <a
            href={urlOfCategory(node.path)}
            class:list={['node', { current: isCurrent(node.path), ancestor: isAncestor(node.path) }]}
            aria-current={isCurrent(node.path) ? 'page' : undefined}
            title={node.label}
          >
            <span class="label">{node.label}</span>
            <span class="count">{node.totalCount}</span>
          </a>
        </div>

        {hasChildren && (
          <div class="children" hidden={!expanded}>
            <Astro.self nodes={node.children} current={current} />
          </div>
        )}
      </li>
    );
  })}
</ul>

<style>
  ul { list-style: none; margin: 0; padding: 0; }
  li { margin: 0; }

  .row {
    display: flex;
    align-items: center;
    gap: .1rem;
    padding-left: var(--indent, 0);
  }

  .caret {
    flex-shrink: 0;
    display: grid;
    place-items: center;
    width: 1.1rem;
    height: 1.1rem;
    padding: 0;
    border: 0;
    background: none;
    color: var(--text-faint);
    cursor: pointer;
    border-radius: 4px;
    transition: color .15s, background .15s;
  }
  .caret svg { transition: transform .15s; }
  .caret[aria-expanded='true'] svg { transform: rotate(90deg); }
  .caret:hover { color: var(--text); background: var(--bg-subtle); }
  .caret--empty { cursor: default; }

  .node {
    flex: 1;
    min-width: 0;               /* 이게 없으면 긴 이름이 사이드바를 밀어냅니다 */
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: .5rem;
    padding: .28rem .45rem;
    border-radius: 6px;
    font-size: .875rem;
    color: var(--text-muted);
    transition: color .15s, background .15s;
  }
  .node:hover { color: var(--text); background: var(--bg-subtle); }

  /* 긴 카테고리 이름은 잘라내고, 전체 이름은 title 속성으로 보여줍니다. */
  .label {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .node.current {
    color: var(--accent);
    background: var(--accent-soft);
    font-weight: 600;
  }
  .node.ancestor { color: var(--text); font-weight: 600; }

  .count {
    flex-shrink: 0;
    font-size: .7rem;
    color: var(--text-faint);
    font-variant-numeric: tabular-nums;
  }

  /* 계층을 나타내는 세로선. 들여쓰기 위치에 맞춰 그립니다. */
  .children {
    position: relative;
    margin-left: calc(var(--indent, 0) + .55rem);
  }
  .children::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    border-left: 1px solid var(--border);
  }
</style>

<script>
  // 캐럿으로 접고 펴기. 어떤 걸 접어뒀는지 기억해서 페이지를 옮겨도 유지합니다.
  const STORAGE_KEY = 'category-tree-collapsed';

  const readCollapsed = (): Set<string> => {
    try {
      return new Set(JSON.parse(localStorage.getItem(STORAGE_KEY) ?? '[]'));
    } catch {
      return new Set();
    }
  };

  const writeCollapsed = (set: Set<string>) => {
    try {
      localStorage.setItem(STORAGE_KEY, JSON.stringify([...set]));
    } catch {
      // 저장이 막힌 환경(사생활 보호 모드 등)에서는 그냥 넘어갑니다.
    }
  };

  const collapsed = readCollapsed();

  for (const item of document.querySelectorAll<HTMLLIElement>('.item[data-has-children="true"]')) {
    const path = item.dataset.path!;
    const caret = item.querySelector<HTMLButtonElement>('.caret')!;
    const children = item.querySelector<HTMLElement>('.children')!;

    // 현재 위치로 가는 길목은 접어둔 기록이 있어도 펼쳐 둡니다.
    // 지금 보고 있는 카테고리가 접혀서 안 보이는 상황을 막기 위해서입니다.
    const onActivePath = caret.getAttribute('aria-expanded') === 'true';
    if (!onActivePath && collapsed.has(path)) {
      children.hidden = true;
      caret.setAttribute('aria-expanded', 'false');
    }

    caret.addEventListener('click', () => {
      const nowHidden = !children.hidden;
      children.hidden = nowHidden;
      caret.setAttribute('aria-expanded', nowHidden ? 'false' : 'true');

      if (nowHidden) collapsed.add(path);
      else collapsed.delete(path);
      writeCollapsed(collapsed);
    });
  }
</script>
