---
import { breadcrumbOf, urlOfCategory, type CategoryNode } from '../lib/categories';

interface Props {
  nodes: CategoryNode[];
  /** 현재 보고 있는 카테고리 경로. 해당 항목이 강조됩니다. */
  current?: string;
}

const { nodes, current = '' } = Astro.props;

/** 하위 전체를 한 줄로 펼칩니다. 최상위 바로 뒤에 그 하위들이 오도록 순서를 유지합니다. */
function withDescendants(node: CategoryNode): CategoryNode[] {
  return [node, ...node.children.flatMap(withDescendants)];
}

const items = nodes.flatMap(withDescendants);
---

<div class="tree">
  {items.map((node) => (
    <a
      href={urlOfCategory(node.path)}
      class:list={['btn', { current: current === node.path }]}
      aria-current={current === node.path ? 'page' : undefined}
      title={breadcrumbOf(node.path).map((step) => step.label).join(' › ')}
    >
      <span class="text">
        {/*
          모든 버튼이 같은 모양이라 위치만으로는 상하위를 알 수 없습니다.
          그래서 하위는 '백엔드 › Spring' 처럼 경로를 그대로 밝힙니다.
        */}
        {breadcrumbOf(node.path).map((step, i) => (
          <>
            {i > 0 && <span class="sep" aria-hidden="true">›</span>}
            <span class="seg">{step.label}</span>
          </>
        ))}
      </span>
      <span class="n">{node.totalCount}</span>
    </a>
  ))}
</div>

<style>
  /*
   * 모든 카테고리를 같은 버튼으로 두고 한 줄에 이어 붙입니다.
   * 최상위를 왼쪽 열에 고정했더니 하위가 없는 카테고리에서 오른쪽이 비어
   * 표가 깨진 것처럼 보여서, 열을 없애고 흐르게 했습니다.
   */
  /*
   * 격자로 두어 줄 끝이 항상 맞습니다. 버튼 폭이 제각각이면 오른쪽이 남는데,
   * 같은 폭의 칸에 채우면 그 여백이 사라집니다.
   */
  .tree {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(10rem, 1fr));
    gap: .5rem;
  }

  .btn {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: .5rem;
    min-width: 0;
    padding: .5rem 1rem;
    background: var(--surface);
    border: 1px solid var(--border-strong);
    border-radius: 999px;
    font-size: .85rem;
    color: var(--text);
    transition:
      color .18s ease,
      background .18s ease,
      border-color .18s ease,
      box-shadow .18s ease;
  }
  .btn:hover {
    color: var(--accent);
    border-color: var(--accent);
    background: var(--accent-soft);
    box-shadow: 0 3px 12px color-mix(in srgb, var(--accent) 18%, transparent);
  }
  .btn.current {
    color: var(--accent);
    border-color: var(--accent);
    background: var(--accent-soft);
    font-weight: 700;
  }

  /* 칸보다 이름이 길면 잘라내고, 전체 이름은 title 속성으로 보여줍니다. */
  .text {
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  /* 경로의 앞쪽은 흐리게 해서 마지막 이름이 먼저 읽히게 합니다. */
  .seg:not(:last-of-type) { color: var(--text-faint); }
  .sep { color: var(--text-faint); font-size: .82em; margin-inline: .1rem; }

  .n {
    flex-shrink: 0;
    font-size: .72rem;
    color: var(--text-faint);
    font-variant-numeric: tabular-nums;
  }
  .btn.current .n { color: inherit; opacity: .7; }
</style>
