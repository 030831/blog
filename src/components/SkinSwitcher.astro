---
// 디자인 시안을 실제 사이트에서 바로 바꿔보는 도구.
// 고르고 나면 config.ts 의 showSkinSwitcher 를 false 로 두면 사라집니다.
const SKINS = [
  { id: 'warm', name: '따뜻한 종이', desc: '차분하고 오래 읽기 좋음' },
  { id: 'ink', name: '잉크', desc: '고대비 · 세리프 제목 · 잡지풍' },
  { id: 'terminal', name: '터미널', desc: '개발자 색채 · 모노스페이스' },
  { id: 'nordic', name: '노르딕', desc: '차가운 회청색 · 넓은 여백' },
];
---

<div class="switcher">
  <button class="trigger" type="button" aria-expanded="false" aria-controls="skin-panel">
    디자인
  </button>

  <div class="panel" id="skin-panel" hidden>
    <p class="head">디자인 시안</p>
    <ul>
      {SKINS.map((skin) => (
        <li>
          <button type="button" class="opt" data-skin-id={skin.id}>
            <span class="dot" data-dot={skin.id} aria-hidden="true"></span>
            <span class="text">
              <span class="name">{skin.name}</span>
              <span class="desc">{skin.desc}</span>
            </span>
          </button>
        </li>
      ))}
    </ul>
    <p class="hint">라이트/다크는 위쪽 아이콘으로 따로 전환됩니다.</p>
  </div>
</div>

<style>
  .switcher { position: fixed; right: 1rem; bottom: 1rem; z-index: 50; }

  .trigger {
    padding: .5rem .9rem;
    font-family: var(--font-sans);
    font-size: .8125rem;
    font-weight: 600;
    color: var(--text);
    background: var(--surface);
    border: 1px solid var(--border-strong);
    border-radius: 999px;
    box-shadow: 0 2px 10px rgb(0 0 0 / .10);
    cursor: pointer;
  }
  .trigger:hover { border-color: var(--accent); color: var(--accent); }

  .panel {
    position: absolute;
    right: 0;
    bottom: 2.75rem;
    width: 15.5rem;
    padding: .8rem;
    background: var(--surface);
    border: 1px solid var(--border-strong);
    border-radius: var(--radius);
    box-shadow: 0 8px 30px rgb(0 0 0 / .16);
  }
  .head {
    margin: 0 0 .55rem .15rem;
    font-size: .7rem;
    font-weight: 700;
    letter-spacing: .08em;
    text-transform: uppercase;
    color: var(--text-faint);
  }
  ul { list-style: none; margin: 0; padding: 0; display: grid; gap: .2rem; }

  .opt {
    display: flex;
    align-items: center;
    gap: .6rem;
    width: 100%;
    padding: .5rem;
    text-align: left;
    background: none;
    border: 1px solid transparent;
    border-radius: var(--radius-sm);
    cursor: pointer;
    font-family: var(--font-sans);
    color: var(--text);
  }
  .opt:hover { background: var(--bg-subtle); }
  .opt[aria-current='true'] { border-color: var(--accent); background: var(--accent-soft); }

  .dot {
    flex-shrink: 0;
    width: 1.1rem;
    height: 1.1rem;
    border-radius: 50%;
    border: 1px solid rgb(0 0 0 / .15);
  }
  /* 각 시안의 대표 색 */
  .dot[data-dot='warm']     { background: linear-gradient(135deg, #fbfaf8 50%, #b4531f 50%); }
  .dot[data-dot='ink']      { background: linear-gradient(135deg, #ffffff 50%, #c81e1e 50%); }
  .dot[data-dot='terminal'] { background: linear-gradient(135deg, #0d1117 50%, #3fb950 50%); }
  .dot[data-dot='nordic']   { background: linear-gradient(135deg, #f8fafc 50%, #2563eb 50%); }

  .text { display: grid; gap: .1rem; min-width: 0; }
  .name { font-size: .84rem; font-weight: 600; }
  .desc { font-size: .72rem; color: var(--text-muted); }

  .hint {
    margin: .6rem .15rem 0;
    font-size: .7rem;
    color: var(--text-faint);
    line-height: 1.5;
  }
</style>

<script>
  const trigger = document.querySelector<HTMLButtonElement>('.switcher .trigger')!;
  const panel = document.getElementById('skin-panel')!;
  const options = document.querySelectorAll<HTMLButtonElement>('.switcher .opt');

  const markCurrent = () => {
    const active = document.documentElement.dataset.skin;
    for (const opt of options) {
      opt.setAttribute('aria-current', opt.dataset.skinId === active ? 'true' : 'false');
    }
  };
  markCurrent();

  trigger.addEventListener('click', () => {
    const open = panel.hidden;
    panel.hidden = !open;
    trigger.setAttribute('aria-expanded', open ? 'true' : 'false');
  });

  for (const opt of options) {
    opt.addEventListener('click', () => {
      const id = opt.dataset.skinId!;
      try { localStorage.setItem('skin', id); } catch {}

      // 저장한 뒤 새로 그립니다.
      // 스킨은 색뿐 아니라 글꼴과 여백까지 바꾸기 때문에, 부분 갱신보다
      // 한 번 다시 그리는 쪽이 모든 브라우저에서 확실합니다.
      // (시안을 고르기 위한 임시 도구라 새로고침 비용은 문제되지 않습니다)
      location.reload();
    });
  }

  // 패널 밖을 누르면 닫습니다.
  document.addEventListener('click', (e) => {
    if (!panel.hidden && !(e.target as Element).closest('.switcher')) {
      panel.hidden = true;
      trigger.setAttribute('aria-expanded', 'false');
    }
  });
</script>
