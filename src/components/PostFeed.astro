---
// 홈의 글 목록. 카드 + 검색 결과 자리 + 쪽 이동.
import PostCard from './PostCard.astro';
import SearchResults from './SearchResults.astro';
import Pagination from './Pagination.astro';
import type { Post } from '../lib/posts';

interface Props {
  posts: Post[];
  current: number;
  total: number;
}
const { posts, current, total } = Astro.props;
---

<div class="feed">
  <SearchResults />

  <div id="post-list">
    {posts.length === 0 ? (
      <p class="empty">
        아직 글이 없습니다. <code>src/content/posts/</code> 에 마크다운 파일을 추가해 보세요.
      </p>
    ) : (
      <div class="cards">
        {posts.map((post) => <PostCard post={post} />)}
      </div>
    )}

    <Pagination current={current} total={total} base="/" />
  </div>
</div>

<style>
  .cards { display: grid; gap: .9rem; }

  /* 카드가 순서대로 살짝 떠오르며 나타납니다. */
  .cards > :global(*) { animation: card-in .4s ease both; }
  .cards > :global(*:nth-child(1)) { animation-delay: .02s; }
  .cards > :global(*:nth-child(2)) { animation-delay: .06s; }
  .cards > :global(*:nth-child(3)) { animation-delay: .1s; }
  .cards > :global(*:nth-child(4)) { animation-delay: .14s; }
  .cards > :global(*:nth-child(n+5)) { animation-delay: .18s; }

  @keyframes card-in {
    from { opacity: 0; transform: translateY(10px); }
    to   { opacity: 1; transform: none; }
  }

  .empty { color: var(--text-muted); padding-block: 3rem; text-align: center; }
  .empty code {
    font-family: var(--font-mono);
    font-size: .875em;
    background: var(--bg-subtle);
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    padding: .12em .38em;
  }

  @media (prefers-reduced-motion: reduce) {
    .cards > :global(*) { animation: none; }
  }
</style>
