---
import { SITE } from '../config';
import ThemeToggle from './ThemeToggle.astro';

const path = Astro.url.pathname;
const isActive = (href: string) =>
  href === '/' ? path === '/' : path === href || path.startsWith(href + '/');

const NAV = [
  { href: '/', label: '홈' },
  { href: '/posts', label: '글' },
  { href: '/categories', label: '카테고리' },
];
---

<header class="site-header">
  <!-- 머리말: 이름과 한 줄 소개만. 다른 요소를 섞지 않습니다. -->
  <div class="masthead">
    <a href="/" class="brand" aria-label={`${SITE.title} 홈`}>
      <span class="brand-mark">{SITE.title}</span>
    </a>
    <p class="tagline">{SITE.tagline}</p>
  </div>

  <!-- 도구 막대: 이동은 왼쪽, 검색은 오른쪽. 얇은 선으로만 구분합니다. -->
  <div class="bar">
    <nav class="nav" aria-label="주요 메뉴">
      {NAV.map((item) => (
        <a href={item.href} class:list={['nav-link', { on: isActive(item.href) }]}>
          {item.label}
        </a>
      ))}
    </nav>

    <div class="tools">
      <form class="search" role="search" id="site-search" autocomplete="off">
        <label class="sr-only" for="search-input">검색어</label>
        <svg class="search-icon" viewBox="0 0 16 16" width="15" height="15" aria-hidden="true">
          <circle cx="7.2" cy="7.2" r="4.4" fill="none" stroke="currentColor" stroke-width="1.5" />
          <path d="m10.6 10.6 3 3" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
        </svg>

        <input id="search-input" type="search" placeholder="검색" aria-describedby="search-hint" />

        <button type="button" class="clear" id="search-clear" hidden aria-label="검색어 지우기">
          <svg viewBox="0 0 16 16" width="12" height="12" aria-hidden="true">
            <path d="m4.5 4.5 7 7m0-7-7 7" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" />
          </svg>
        </button>

        <label class="sr-only" for="search-scope">검색 범위</label>
        <select id="search-scope" class="scope">
          <option value="title">제목</option>
          <option value="all">제목+내용</option>
          <option value="category">카테고리</option>
        </select>
      </form>

      <ThemeToggle />
    </div>
  </div>
  <p id="search-hint" class="sr-only">입력하면 결과가 바로 아래에 표시됩니다.</p>
</header>

<style>
  .site-header {
    max-width: 46rem;
    margin-inline: auto;
    padding-inline: 1.5rem;
  }

  /* ── 머리말 ── */
  .masthead {
    text-align: center;
    padding-block: 3rem 2.25rem;
  }

  .brand { display: inline-block; }
  .brand-mark {
    display: inline-block;
    padding: .5rem 1.05rem;
    background: var(--text);
    color: var(--bg);
    border-radius: 5px;
    /* 숫자로 된 이름이라 자간을 살짝 벌려야 한 덩어리로 읽힙니다. */
    font-size: 1.15rem;
    font-weight: 700;
    letter-spacing: .04em;
    transition: opacity .2s ease;
  }
  .brand:hover .brand-mark { opacity: .82; }

  .tagline {
    margin: 1.05rem auto 0;
    max-width: 26rem;
    font-size: .85rem;
    line-height: 1.65;
    color: var(--text-muted);
  }

  /* ── 도구 막대 ── */
  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.25rem;
    height: 3.25rem;
    border-top: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
  }

  .nav { display: flex; align-items: center; gap: .25rem; }
  .nav-link {
    position: relative;
    padding: .4rem .6rem;
    font-size: .875rem;
    color: var(--text-muted);
    transition: color .18s ease;
  }
  .nav-link:hover { color: var(--text); }
  .nav-link.on { color: var(--text); font-weight: 600; }

  /* 현재 위치는 밑줄로만 표시합니다. 색을 더 쓰면 시선이 분산됩니다. */
  .nav-link.on::after {
    content: '';
    position: absolute;
    left: .6rem;
    right: .6rem;
    bottom: -.15rem;
    height: 2px;
    background: var(--accent);
  }

  .tools { display: flex; align-items: center; gap: .5rem; }

  /* ── 검색 ── */
  .search {
    display: flex;
    align-items: center;
    gap: .45rem;
    width: clamp(11rem, 26vw, 17rem);
    padding: .34rem .6rem;
    background: var(--bg-subtle);
    border: 1px solid transparent;
    border-radius: 7px;
    transition: background .18s ease, border-color .18s ease, box-shadow .18s ease;
  }
  .search:focus-within {
    background: var(--surface);
    border-color: var(--accent);
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--accent) 14%, transparent);
  }
  .search-icon { flex-shrink: 0; color: var(--text-faint); transition: color .18s ease; }
  .search:focus-within .search-icon { color: var(--accent); }

  .search input {
    flex: 1;
    min-width: 0;
    padding: .12rem 0;
    border: 0;
    background: none;
    font-family: var(--font-sans);
    font-size: .85rem;
    color: var(--text);
  }
  .search input:focus { outline: none; }
  .search input::placeholder { color: var(--text-faint); }
  .search input::-webkit-search-cancel-button { display: none; }

  .clear {
    flex-shrink: 0;
    display: grid;
    place-items: center;
    width: 1.1rem;
    height: 1.1rem;
    padding: 0;
    border: 0;
    border-radius: 50%;
    background: var(--border);
    color: var(--text-muted);
    cursor: pointer;
    transition: background .18s ease, color .18s ease;
  }
  .clear:hover { background: var(--accent); color: #fff; }
  .clear[hidden] { display: none; }

  .scope {
    flex-shrink: 0;
    padding: .1rem 1rem .1rem .3rem;
    border: 0;
    background: transparent;
    font-family: var(--font-sans);
    font-size: .78rem;
    color: var(--text-muted);
    cursor: pointer;
    appearance: none;
    background-image:
      linear-gradient(45deg, transparent 50%, currentColor 50%),
      linear-gradient(135deg, currentColor 50%, transparent 50%);
    background-position: right .42rem center, right .22rem center;
    background-size: 4px 4px, 4px 4px;
    background-repeat: no-repeat;
  }
  .scope:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; border-radius: 3px; }

  @media (max-width: 40rem) {
    .masthead { padding-block: 2.25rem 1.75rem; }
    .bar {
      height: auto;
      flex-direction: column;
      align-items: stretch;
      gap: .6rem;
      padding-block: .7rem;
    }
    .nav { justify-content: center; }
    .nav-link.on::after { bottom: .1rem; }
    .search { width: auto; flex: 1; }
  }
</style>

<script>
  /*
   * 이 페이지에 검색 결과를 그릴 자리가 없으면(예: 글 상세 페이지)
   * 검색어를 들고 홈으로 이동합니다. 입력만 되고 아무 일도 안 일어나는
   * 상황을 막기 위한 처리입니다.
   */
  if (!document.getElementById('search-results')) {
    const form = document.getElementById('site-search') as HTMLFormElement | null;
    const input = document.getElementById('search-input') as HTMLInputElement | null;
    const scope = document.getElementById('search-scope') as HTMLSelectElement | null;

    form?.addEventListener('submit', (e) => {
      e.preventDefault();
      const query = input?.value.trim();
      if (!query) return;
      const params = new URLSearchParams({ q: query, scope: scope?.value ?? 'title' });
      location.href = `/?${params}`;
    });
  }
</script>
