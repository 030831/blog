---
// 테마 시안 목록. 고르고 나면 이 폴더(src/pages/themes)를 통째로 지웁니다.
import DemoShell from '../../layouts/DemoShell.astro';

const THEMES = [
  {
    n: 1,
    name: '미니멀 저널',
    like: 'Jekyll minima 계열',
    desc: '장식을 최대한 걷어낸 한 줄 목록. 날짜와 제목만 보입니다. 글이 많아져도 훑기 쉽고, 무엇보다 안 질립니다.',
    good: '글 자체에 집중시키고 싶을 때',
    bad: '첫인상이 심심할 수 있음',
  },
  {
    n: 2,
    name: '프로필 사이드바',
    like: 'Chirpy 계열',
    desc: '왼쪽에 프로필과 카테고리가 항상 고정됩니다. 방문자가 "누가 쓴 블로그인지"를 바로 알게 되고, 카테고리 이동이 한 번에 됩니다.',
    good: '포트폴리오로 보여줄 때 · 카테고리가 많을 때',
    bad: '본문 폭이 줄어듦',
  },
  {
    n: 3,
    name: '매거진 그리드',
    like: 'Hydejack / 미디엄 계열',
    desc: '최신 글을 큰 히어로로 띄우고 나머지를 카드 격자로 배치합니다. 시각적으로 가장 화려합니다.',
    good: '보여주기 좋은 인상 · 이미지가 있는 글',
    bad: '글마다 대표 이미지가 필요함. 없으면 허전해짐',
  },
  {
    n: 4,
    name: '터미널',
    like: 'hacker 계열 테마',
    desc: '셸 세션처럼 생긴 블로그. ls 결과처럼 글이 나열됩니다. 개발자 정체성이 가장 강하게 드러납니다.',
    good: '확실한 개성 · 개발자 대상',
    bad: '긴 글 읽기에는 불리 · 호불호 갈림',
  },
  {
    n: 5,
    name: '스플릿 스크린',
    like: '포트폴리오 사이트 계열',
    desc: '왼쪽 절반은 고정된 표지, 오른쪽만 스크롤됩니다. 이름과 소개가 계속 보여서 명함 같은 인상을 줍니다.',
    good: '취업용 포트폴리오 · 글 수가 적을 때',
    bad: '글이 수백 개가 되면 왼쪽 공간이 아까워짐',
  },
];
---

<DemoShell title="블로그 테마 시안">
  <main class="page">
    <header>
      <h1>테마 시안</h1>
      <p>
        색만 바꾼 게 아니라 구조가 서로 다른 시안입니다.
        전부 실제 글 데이터로 렌더링했습니다. 눌러서 직접 보시고 번호로 알려주세요.
      </p>
    </header>

    <ul class="list">
      {THEMES.map((t) => (
        <li>
          <a href={`/themes/${t.n}/`}>
            <span class="n">{String(t.n).padStart(2, '0')}</span>
            <span class="body">
              <span class="name">{t.name}</span>
              <span class="like">{t.like}</span>
              <span class="desc">{t.desc}</span>
              <span class="pros">
                <span class="good">잘 맞음 · {t.good}</span>
                <span class="bad">주의 · {t.bad}</span>
              </span>
            </span>
          </a>
        </li>
      ))}
    </ul>

    <p class="foot">
      섞어도 됩니다. "2번 구조에 4번 코드 블록 느낌" 같은 것도 가능합니다.
    </p>
  </main>
</DemoShell>

<style>
  .page { max-width: 46rem; margin-inline: auto; padding: 4rem 1.5rem 6rem; }
  header h1 { margin: 0; font-size: 2rem; font-weight: 800; letter-spacing: -0.035em; }
  header p { margin: .8rem 0 3rem; color: var(--text-muted); line-height: 1.7; }

  .list { list-style: none; margin: 0; padding: 0; display: grid; gap: 1rem; }
  .list a {
    display: flex;
    gap: 1.25rem;
    padding: 1.4rem 1.5rem;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--surface);
    transition: border-color .15s, transform .15s;
  }
  .list a:hover { border-color: var(--accent); transform: translateY(-2px); }

  .n {
    flex-shrink: 0;
    font-family: var(--font-mono);
    font-size: .8rem;
    color: var(--text-faint);
    padding-top: .2rem;
  }
  .body { display: grid; gap: .3rem; min-width: 0; }
  .name { font-size: 1.1rem; font-weight: 700; letter-spacing: -0.02em; }
  .like { font-size: .75rem; color: var(--accent); }
  .desc { font-size: .9rem; color: var(--text-muted); line-height: 1.65; margin-top: .2rem; }

  .pros { display: grid; gap: .2rem; margin-top: .6rem; font-size: .78rem; }
  .good { color: var(--text-muted); }
  .bad { color: var(--text-faint); }

  .foot {
    margin-top: 2.5rem;
    font-size: .875rem;
    color: var(--text-faint);
    text-align: center;
  }
</style>
