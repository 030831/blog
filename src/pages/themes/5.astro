---
// [시안 5] 스플릿 스크린 — 왼쪽 절반은 고정된 표지, 오른쪽만 스크롤.
import DemoShell from '../../layouts/DemoShell.astro';
import { getPublishedPosts, urlOf, categoryOf } from '../../lib/posts';
import { labelOf } from '../../lib/categories';

const posts = await getPublishedPosts();
const fmt = (d: Date) =>
  new Intl.DateTimeFormat('ko-KR', { year: 'numeric', month: '2-digit', day: '2-digit' })
    .format(d)
    .replace(/\.$/, '');
---

<DemoShell title="시안 5 · 스플릿 스크린">
  <div class="split">
    <section class="cover">
      <div class="cover-inner">
        <p class="hello">개발 기록</p>
        <h1>030831</h1>
        <p class="bio">
          백엔드 개발을 공부하며 막혔던 지점과<br />
          그걸 풀어낸 과정을 남깁니다.
        </p>

        <nav>
          <a href="#" class="on">글</a>
          <a href="#">카테고리</a>
          <a href="#">태그</a>
          <a href="#">소개</a>
        </nav>

        <p class="links">GitHub · RSS</p>
      </div>
    </section>

    <section class="stream">
      {posts.map((post, i) => (
        <a href={urlOf(post)} class="entry">
          <span class="num">{String(i + 1).padStart(2, '0')}</span>
          <span class="body">
            <span class="cat">{labelOf(categoryOf(post))}</span>
            <span class="title">{post.data.title}</span>
            <span class="desc">{post.data.description}</span>
            <span class="date">{fmt(post.data.date)}</span>
          </span>
        </a>
      ))}
    </section>
  </div>
</DemoShell>

<style>
  .split { display: grid; grid-template-columns: 1fr 1fr; min-height: 100vh; }

  .cover {
    position: sticky;
    top: 0;
    height: 100vh;
    display: grid;
    align-items: center;
    padding: 3rem;
    background: var(--text);
    color: var(--bg);
  }
  .cover-inner { max-width: 22rem; }
  .hello {
    margin: 0 0 .9rem;
    font-size: .75rem;
    font-weight: 700;
    letter-spacing: .14em;
    text-transform: uppercase;
    opacity: .55;
  }
  .cover h1 {
    margin: 0;
    font-size: clamp(2.5rem, 5vw, 3.75rem);
    font-weight: 800;
    letter-spacing: -0.04em;
    line-height: 1;
  }
  .bio { margin: 1.4rem 0 2.5rem; font-size: .95rem; line-height: 1.75; opacity: .7; }

  .cover nav { display: flex; flex-direction: column; gap: .1rem; align-items: flex-start; }
  .cover nav a {
    padding: .3rem 0;
    font-size: 1.05rem;
    font-weight: 600;
    opacity: .55;
    border-bottom: 2px solid transparent;
  }
  .cover nav a:hover { opacity: 1; }
  .cover nav a.on { opacity: 1; border-bottom-color: var(--accent); }

  .links { margin: 2.5rem 0 0; font-size: .8rem; opacity: .45; }

  .stream { padding: 4rem 3rem; }
  .entry {
    display: flex;
    gap: 1.5rem;
    padding: 1.75rem 0;
    border-bottom: 1px solid var(--border);
  }
  .entry:first-child { padding-top: 0; }
  .num {
    flex-shrink: 0;
    font-size: .75rem;
    font-variant-numeric: tabular-nums;
    color: var(--text-faint);
    padding-top: .35rem;
  }
  .body { display: grid; gap: .35rem; min-width: 0; }
  .cat {
    font-size: .7rem;
    font-weight: 700;
    letter-spacing: .08em;
    text-transform: uppercase;
    color: var(--accent);
  }
  .title { font-size: 1.15rem; font-weight: 700; line-height: 1.4; letter-spacing: -0.02em; }
  .entry:hover .title { color: var(--accent); }
  .desc { font-size: .875rem; color: var(--text-muted); line-height: 1.6; }
  .date { font-size: .75rem; color: var(--text-faint); margin-top: .3rem; }

  @media (max-width: 56rem) {
    .split { grid-template-columns: 1fr; }
    .cover { position: static; height: auto; padding: 3.5rem 2rem; }
    .stream { padding: 2.5rem 2rem; }
  }
</style>
