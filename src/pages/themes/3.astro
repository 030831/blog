---
// [시안 3] 매거진 그리드 — 큰 히어로 + 카드 격자. 포트폴리오 성격이 강함.
import DemoShell from '../../layouts/DemoShell.astro';
import { getPublishedPosts, urlOf, categoryOf } from '../../lib/posts';
import { labelOf } from '../../lib/categories';

const posts = await getPublishedPosts();
const [hero, ...rest] = posts;
const fmt = (d: Date) =>
  new Intl.DateTimeFormat('ko-KR', { month: 'long', day: 'numeric' }).format(d);

// 시안이라 타일이 부족하면 같은 글을 채워 격자 느낌을 보여줍니다.
const tiles = [...rest, ...posts].slice(0, 6);
---

<DemoShell title="시안 3 · 매거진 그리드">
  <header class="bar">
    <a href="#" class="logo">030831</a>
    <nav><a href="#">글</a><a href="#">카테고리</a><a href="#">태그</a><a href="#">소개</a></nav>
  </header>

  <main class="wrap">
    <section class="hero">
      <p class="kicker">{labelOf(categoryOf(hero))}</p>
      <h1><a href={urlOf(hero)}>{hero.data.title}</a></h1>
      <p class="lede">{hero.data.description}</p>
      <p class="hero-meta">{fmt(hero.data.date)}</p>
    </section>

    <div class="chips">
      <button class="chip on" type="button">전체</button>
      <button class="chip" type="button">백엔드</button>
      <button class="chip" type="button">알고리즘</button>
      <button class="chip" type="button">블로그</button>
    </div>

    <div class="grid">
      {tiles.map((post) => (
        <article class="tile">
          <div class="thumb" aria-hidden="true">
            <span>{labelOf(categoryOf(post))}</span>
          </div>
          <h3><a href={urlOf(post)}>{post.data.title}</a></h3>
          <p>{post.data.description}</p>
          <time>{fmt(post.data.date)}</time>
        </article>
      ))}
    </div>
  </main>
</DemoShell>

<style>
  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1.1rem 2rem;
    border-bottom: 1px solid var(--border);
    position: sticky;
    top: 0;
    background: var(--bg);
    z-index: 10;
  }
  .logo { font-weight: 800; font-size: 1.1rem; letter-spacing: -0.02em; }
  .bar nav { display: flex; gap: 1.4rem; font-size: .9rem; }
  .bar nav a { color: var(--text-muted); }
  .bar nav a:hover { color: var(--accent); }

  .wrap { max-width: 68rem; margin-inline: auto; padding: 3.5rem 2rem 5rem; }

  .hero { padding-bottom: 3rem; border-bottom: 1px solid var(--border); }
  .kicker {
    margin: 0 0 .8rem;
    font-size: .75rem;
    font-weight: 700;
    letter-spacing: .1em;
    text-transform: uppercase;
    color: var(--accent);
  }
  .hero h1 {
    margin: 0;
    font-size: clamp(1.9rem, 4.5vw, 3rem);
    font-weight: 800;
    line-height: 1.15;
    letter-spacing: -0.04em;
    max-width: 20ch;
  }
  .hero h1 a:hover { color: var(--accent); }
  .lede {
    margin: 1.1rem 0 0;
    font-size: 1.05rem;
    color: var(--text-muted);
    max-width: 45ch;
    line-height: 1.65;
  }
  .hero-meta { margin: 1.2rem 0 0; font-size: .82rem; color: var(--text-faint); }

  .chips { display: flex; gap: .5rem; flex-wrap: wrap; margin: 2.5rem 0 2rem; }
  .chip {
    padding: .4rem .95rem;
    font-family: var(--font-sans);
    font-size: .84rem;
    color: var(--text-muted);
    background: none;
    border: 1px solid var(--border);
    border-radius: 999px;
    cursor: pointer;
  }
  .chip:hover { border-color: var(--border-strong); color: var(--text); }
  .chip.on { background: var(--text); color: var(--bg); border-color: var(--text); }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(16rem, 1fr));
    gap: 2rem 1.75rem;
  }
  .tile h3 { margin: .9rem 0 0; font-size: 1.02rem; line-height: 1.45; letter-spacing: -0.015em; }
  .tile h3 a:hover { color: var(--accent); }
  .tile p {
    margin: .45rem 0 0;
    font-size: .85rem;
    color: var(--text-muted);
    line-height: 1.6;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .tile time { display: block; margin-top: .7rem; font-size: .75rem; color: var(--text-faint); }

  /* 실제 운영에서는 여기에 글 대표 이미지가 들어갑니다.
     지금은 이미지가 없으므로 자리만 잡아 두었습니다. */
  .thumb {
    aspect-ratio: 16 / 10;
    display: grid;
    place-items: center;
    border-radius: var(--radius);
    background:
      repeating-linear-gradient(45deg, var(--bg-subtle) 0 10px, transparent 10px 20px),
      var(--surface);
    border: 1px solid var(--border);
  }
  .thumb span {
    font-size: .75rem;
    font-weight: 600;
    letter-spacing: .06em;
    text-transform: uppercase;
    color: var(--text-faint);
    background: var(--bg);
    padding: .25rem .6rem;
    border-radius: 999px;
  }
</style>
