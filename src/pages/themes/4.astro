---
// [시안 4] 터미널 — 셸 세션처럼 보이는 블로그.
import DemoShell from '../../layouts/DemoShell.astro';
import { getPublishedPosts, urlOf, categoryOf } from '../../lib/posts';

const posts = await getPublishedPosts();
const iso = (d: Date) => d.toISOString().slice(0, 10);
---

<DemoShell title="시안 4 · 터미널">
  <div class="term">
    <div class="chrome">
      <span class="dot r"></span><span class="dot y"></span><span class="dot g"></span>
      <span class="win-title">030831@blog: ~</span>
    </div>

    <div class="screen">
      <p class="line"><span class="prompt">030831@blog</span>:<span class="path">~</span>$ whoami</p>
      <p class="out">백엔드 개발을 공부하며 남기는 기록. Java, Spring, MySQL.</p>

      <p class="line"><span class="prompt">030831@blog</span>:<span class="path">~</span>$ ls -la posts/</p>

      <ul class="files">
        {posts.map((post) => (
          <li>
            <span class="perm">-rw-r--r--</span>
            <span class="date">{iso(post.data.date)}</span>
            <span class="dir">{categoryOf(post)}/</span>
            <a href={urlOf(post)}>{post.data.title}</a>
          </li>
        ))}
      </ul>

      <p class="line"><span class="prompt">030831@blog</span>:<span class="path">~</span>$ <span class="cursor"></span></p>
    </div>
  </div>
</DemoShell>

<style>
  /* 이 시안은 화면 전체가 어두운 터미널입니다. */
  :global(body) { background: #0b0e14; }

  .term {
    max-width: 56rem;
    margin: 3rem auto;
    border-radius: 10px;
    overflow: hidden;
    box-shadow: 0 20px 60px rgb(0 0 0 / .5);
    font-family: var(--font-mono);
  }

  .chrome {
    display: flex;
    align-items: center;
    gap: .45rem;
    padding: .7rem .9rem;
    background: #1b2028;
    border-bottom: 1px solid #2a313c;
  }
  .dot { width: .72rem; height: .72rem; border-radius: 50%; }
  .dot.r { background: #ff5f57; }
  .dot.y { background: #febc2e; }
  .dot.g { background: #28c840; }
  .win-title {
    margin-inline: auto;
    font-size: .78rem;
    color: #7d8590;
  }

  .screen {
    padding: 1.5rem 1.6rem 2.5rem;
    background: #0d1117;
    color: #c9d1d9;
    font-size: .88rem;
    line-height: 1.85;
    min-height: 28rem;
  }

  .line { margin: 1.3rem 0 .2rem; }
  .line:first-child { margin-top: 0; }
  .prompt { color: #3fb950; font-weight: 600; }
  .path { color: #58a6ff; }

  .out { margin: 0 0 .4rem; color: #8b949e; }

  .files { list-style: none; margin: .3rem 0 0; padding: 0; }
  .files li {
    display: flex;
    gap: 1.1rem;
    align-items: baseline;
    padding: .12rem 0;
  }
  .perm { color: #6e7681; flex-shrink: 0; }
  .date { color: #58a6ff; flex-shrink: 0; }
  .dir { color: #d29922; flex-shrink: 0; }
  .files a { color: #e6edf3; }
  .files a:hover { color: #3fb950; text-decoration: underline; }

  .cursor {
    display: inline-block;
    width: .55rem;
    height: 1.05rem;
    background: #c9d1d9;
    vertical-align: text-bottom;
    animation: blink 1.1s step-end infinite;
  }
  @keyframes blink { 50% { opacity: 0; } }

  @media (max-width: 44rem) {
    .term { margin: 1rem; }
    .files li { flex-wrap: wrap; gap: .5rem; }
  }
</style>
