---
// [시안 2] 프로필 사이드바 — Chirpy 계열. 왼쪽에 나를 고정 노출.
import DemoShell from '../../layouts/DemoShell.astro';
import { getCategoryTree } from '../../lib/categories';
import { getPublishedPosts, urlOf } from '../../lib/posts';

const posts = await getPublishedPosts();
const tree = await getCategoryTree();
const fmt = (d: Date) =>
  new Intl.DateTimeFormat('ko-KR', { year: 'numeric', month: 'long', day: 'numeric' }).format(d);
---

<DemoShell title="시안 2 · 프로필 사이드바">
  <div class="layout">
    <aside class="profile">
      <div class="avatar" aria-hidden="true">03</div>
      <p class="name">030831</p>
      <p class="tagline">백엔드 개발 공부 기록</p>

      <nav class="menu">
        <a href="#" class="on">홈</a>
        <a href="#">카테고리</a>
        <a href="#">태그</a>
        <a href="#">소개</a>
      </nav>

      <p class="menu-title">카테고리</p>
      <ul class="cats">
        {tree.map((root) => (
          <li>
            <a href="#">{root.label}<span>{root.totalCount}</span></a>
            {root.children.length > 0 && (
              <ul>
                {root.children.map((c) => (
                  <li><a href="#" class="sub">{c.label}<span>{c.totalCount}</span></a></li>
                ))}
              </ul>
            )}
          </li>
        ))}
      </ul>

      <div class="social">GitHub · RSS</div>
    </aside>

    <main class="feed">
      {posts.map((post) => (
        <article class="card">
          <h2><a href={urlOf(post)}>{post.data.title}</a></h2>
          <p class="desc">{post.data.description}</p>
          <div class="meta">
            <time>{fmt(post.data.date)}</time>
            <span class="tags">{post.data.tags.map((t) => `#${t}`).join(' ')}</span>
          </div>
        </article>
      ))}
    </main>
  </div>
</DemoShell>

<style>
  .layout {
    display: grid;
    grid-template-columns: 16rem minmax(0, 1fr);
    min-height: 100vh;
  }

  .profile {
    position: sticky;
    top: 0;
    align-self: start;
    height: 100vh;
    padding: 2.5rem 1.5rem;
    background: var(--bg-subtle);
    border-right: 1px solid var(--border);
    text-align: center;
    overflow-y: auto;
  }
  .avatar {
    width: 5.5rem; height: 5.5rem;
    margin: 0 auto 1rem;
    display: grid; place-items: center;
    border-radius: 50%;
    background: var(--accent);
    color: #fff;
    font-size: 1.5rem; font-weight: 700;
    letter-spacing: -0.02em;
  }
  .name { margin: 0; font-size: 1.15rem; font-weight: 700; }
  .tagline { margin: .3rem 0 1.75rem; font-size: .82rem; color: var(--text-muted); }

  .menu { display: grid; gap: .1rem; margin-bottom: 2rem; }
  .menu a {
    padding: .45rem;
    border-radius: var(--radius-sm);
    font-size: .9rem;
    color: var(--text-muted);
  }
  .menu a:hover { background: var(--surface); color: var(--text); }
  .menu a.on { background: var(--accent-soft); color: var(--accent); font-weight: 600; }

  .menu-title {
    margin: 0 0 .5rem;
    font-size: .68rem; font-weight: 700;
    letter-spacing: .08em; text-transform: uppercase;
    color: var(--text-faint);
    text-align: left;
  }
  .cats { list-style: none; margin: 0 0 2rem; padding: 0; text-align: left; }
  .cats a {
    display: flex; justify-content: space-between;
    padding: .28rem .35rem;
    font-size: .84rem; color: var(--text-muted);
    border-radius: var(--radius-sm);
  }
  .cats a:hover { background: var(--surface); color: var(--text); }
  .cats a span { font-size: .7rem; color: var(--text-faint); }
  .cats ul { list-style: none; margin: 0; padding-left: .7rem; }
  .cats .sub { font-size: .8rem; }

  .social { font-size: .78rem; color: var(--text-faint); }

  .feed { padding: 3rem 2.5rem; max-width: 46rem; }
  .card {
    padding: 1.5rem;
    margin-bottom: 1.25rem;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    transition: border-color .15s, transform .15s;
  }
  .card:hover { border-color: var(--border-strong); transform: translateY(-2px); }
  .card h2 { margin: 0; font-size: 1.2rem; font-weight: 700; letter-spacing: -0.02em; }
  .card h2 a:hover { color: var(--accent); }
  .desc { margin: .5rem 0 0; font-size: .9rem; color: var(--text-muted); line-height: 1.6; }
  .meta {
    display: flex; gap: 1rem; flex-wrap: wrap;
    margin-top: .9rem;
    font-size: .78rem; color: var(--text-faint);
  }

  @media (max-width: 55rem) {
    .layout { grid-template-columns: 1fr; }
    .profile { position: static; height: auto; border-right: 0; border-bottom: 1px solid var(--border); }
    .feed { padding: 2rem 1.5rem; }
  }
</style>
