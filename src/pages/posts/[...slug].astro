---
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import TableOfContents from '../../components/TableOfContents.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import { categoryOf, getPublishedPosts, readingTime, slugOf, urlOf } from '../../lib/posts';

export async function getStaticPaths() {
  const posts = await getPublishedPosts();
  return posts.map((post, i) => ({
    params: { slug: slugOf(post) },
    props: {
      post,
      // 목록이 최신순이므로 앞 항목이 더 최신 글입니다.
      newer: posts[i - 1] ?? null,
      older: posts[i + 1] ?? null,
    },
  }));
}

const { post, newer, older } = Astro.props;
const category = categoryOf(post);
const { Content, headings } = await render(post);
const minutes = readingTime(post.body ?? '');
---

<BaseLayout
  title={post.data.title}
  description={post.data.description}
  date={post.data.date}
>
  <article class="wrap">
    <header class="post-head">
      <Breadcrumb path={category} />
      <h1>{post.data.title}</h1>

      <div class="meta">
        <FormattedDate date={post.data.date} />
        <span aria-hidden="true">·</span>
        <span>약 {minutes}분</span>
        {post.data.updated && (
          <>
            <span aria-hidden="true">·</span>
            <span>수정 <FormattedDate date={post.data.updated} /></span>
          </>
        )}
      </div>

      {post.data.tags.length > 0 && (
        <ul class="tags">
          {post.data.tags.map((tag) => (
            <li><a href={`/tags/${encodeURIComponent(tag)}/`}>#{tag}</a></li>
          ))}
        </ul>
      )}
    </header>

    <TableOfContents headings={headings} />

    <div class="prose">
      <Content />
    </div>
  </article>

  {(newer || older) && (
    <nav class="wrap adjacent" aria-label="다른 글">
      {older ? (
        <a href={urlOf(older)} class="adj prev">
          <span class="label">이전 글</span>
          <span class="t">{older.data.title}</span>
        </a>
      ) : <span />}

      {newer && (
        <a href={urlOf(newer)} class="adj next">
          <span class="label">다음 글</span>
          <span class="t">{newer.data.title}</span>
        </a>
      )}
    </nav>
  )}
</BaseLayout>

<style>
  .post-head { padding-block: 3.5rem 1.5rem; }
  .post-head h1 {
    margin: .6rem 0 0;
    font-size: 2rem;
    font-weight: 800;
    line-height: 1.3;
    letter-spacing: -0.035em;
  }
  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: .5rem;
    margin-top: .9rem;
    font-size: .875rem;
    color: var(--text-faint);
  }
  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: .5rem;
    list-style: none;
    margin: .9rem 0 0;
    padding: 0;
    font-size: .8125rem;
  }
  .tags a {
    display: inline-block;
    padding: .15rem .55rem;
    border: 1px solid var(--border);
    border-radius: 999px;
    color: var(--text-muted);
    transition: color .2s ease, border-color .2s ease, background .2s ease, transform .2s ease;
  }
  .tags a:hover {
    color: var(--accent);
    border-color: var(--accent);
    background: var(--accent-soft);
    transform: translateY(-1px);
  }

  .adjacent {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
    margin-top: 4rem;
    padding-top: 2rem;
    border-top: 1px solid var(--border);
  }
  .adj {
    display: flex;
    flex-direction: column;
    gap: .3rem;
    padding: 1rem 1.1rem;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    transition: border-color .22s ease, background .22s ease, transform .22s ease, box-shadow .22s ease;
  }
  .adj:hover {
    border-color: var(--accent);
    background: var(--accent-soft);
    transform: translateY(-2px);
    box-shadow: 0 5px 18px color-mix(in srgb, var(--text) 7%, transparent);
  }
  .adj .t { transition: color .18s ease; }
  .adj:hover .t { color: var(--accent); }
  .adj.next { text-align: right; }
  .label { font-size: .75rem; color: var(--text-faint); }
  .adj .t { font-size: .9375rem; font-weight: 600; line-height: 1.45; }

  @media (prefers-reduced-motion: reduce) {
    .adj:hover { transform: none; }
    .tags a:hover { transform: none; }
  }

  @media (max-width: 34rem) {
    .adjacent { grid-template-columns: 1fr; }
    .adj.next { text-align: left; }
  }
</style>
