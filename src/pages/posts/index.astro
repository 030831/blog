---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostArchive from '../../components/PostArchive.astro';
import { SITE } from '../../config';
import { getPublishedPosts, paginate } from '../../lib/posts';

const posts = await getPublishedPosts();
const pages = paginate(posts, SITE.postsPerPage);
---

<BaseLayout title="글" description="전체 글 목록">
  <div class="wrap">
    <PostArchive posts={pages[0]} totalPosts={posts.length} current={1} total={pages.length} />
  </div>
</BaseLayout>

<style>
  .wrap { max-width: 46rem; padding-block: 2.75rem 1rem; }
</style>
