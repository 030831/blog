---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCategoryTree, urlOfCategory, type CategoryNode } from '../../lib/categories';

const tree = await getCategoryTree();
const total = tree.reduce((sum, node) => sum + node.totalCount, 0);

/** 손자 이하 카테고리를 한 줄로 펼칩니다. 깊어져도 카드가 길어지지 않게 합니다. */
function descendantsOf(node: CategoryNode): CategoryNode[] {
  return node.children.flatMap((child) => [child, ...descendantsOf(child)]);
}
---

<BaseLayout title="카테고리" description="주제별로 정리한 글">
  <div class="wrap">
    <header class="page-head">
      <h1>카테고리</h1>
      <p>{tree.length}개 주제 · 글 {total}개</p>
    </header>

    {tree.length === 0 ? (
      <p class="empty">아직 카테고리가 없습니다. 글을 폴더에 넣으면 자동으로 만들어집니다.</p>
    ) : (
      <ul class="grid">
        {tree.map((root) => (
          <li class="cat">
            <a href={urlOfCategory(root.path)} class="cat-main">
              <span class="cat-name">{root.label}</span>
              <span class="cat-count">{root.totalCount}</span>
              <svg class="arrow" viewBox="0 0 16 16" width="15" height="15" aria-hidden="true">
                <path d="M3 8h9M8.4 4.2 12.2 8l-3.8 3.8" fill="none" stroke="currentColor"
                      stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            </a>

            {root.children.length > 0 && (
              <ul class="subs">
                {descendantsOf(root).map((child) => (
                  <li style={`--depth: ${child.depth - 2}`}>
                    <a href={urlOfCategory(child.path)}>
                      {child.label}
                      <span class="n">{child.totalCount}</span>
                    </a>
                  </li>
                ))}
              </ul>
            )}
          </li>
        ))}
      </ul>
    )}
  </div>
</BaseLayout>

<style>
  .wrap { max-width: 46rem; padding-block: 2.75rem 1rem; }

  .page-head { margin-bottom: 2rem; }
  .page-head h1 { margin: 0; font-size: 1.9rem; font-weight: 800; letter-spacing: -0.03em; }
  .page-head p { margin: .5rem 0 0; color: var(--text-muted); font-size: .9rem; }

  .grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(15rem, 1fr));
    gap: 1rem;
  }

  .cat {
    padding: 1.35rem 1.5rem 1.25rem;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    transition: border-color .22s ease, box-shadow .22s ease, transform .22s ease;
    animation: cat-in .38s ease both;
  }
  .cat:hover {
    border-color: var(--border-strong);
    box-shadow: 0 6px 22px color-mix(in srgb, var(--text) 8%, transparent);
    transform: translateY(-3px);
  }
  .cat:nth-child(2) { animation-delay: .05s; }
  .cat:nth-child(3) { animation-delay: .1s; }
  .cat:nth-child(n+4) { animation-delay: .15s; }

  @keyframes cat-in {
    from { opacity: 0; transform: translateY(10px); }
    to   { opacity: 1; transform: none; }
  }

  /* ── 상위 카테고리: 크게 ── */
  .cat-main {
    display: flex;
    align-items: center;
    gap: .55rem;
  }
  .cat-name {
    font-size: 1.2rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    transition: color .2s ease;
  }
  .cat:hover .cat-name { color: var(--accent); }

  .cat-count {
    font-size: .75rem;
    color: var(--text-faint);
    font-variant-numeric: tabular-nums;
  }
  .arrow {
    margin-left: auto;
    color: var(--text-faint);
    opacity: 0;
    transform: translateX(-4px);
    transition: opacity .22s ease, transform .24s cubic-bezier(.34, 1.3, .64, 1), color .2s ease;
  }
  .cat:hover .arrow { opacity: 1; transform: translateX(0); color: var(--accent); }

  /* ── 하위 카테고리: 작게 ── */
  .subs {
    list-style: none;
    margin: .95rem 0 0;
    padding: .85rem 0 0;
    border-top: 1px solid var(--border);
    display: grid;
    gap: .1rem;
  }
  .subs li { padding-left: calc(var(--depth, 0) * .75rem); }
  .subs a {
    display: flex;
    align-items: baseline;
    gap: .45rem;
    padding: .25rem .4rem;
    border-radius: var(--radius-sm);
    font-size: .875rem;
    color: var(--text-muted);
    transition: color .18s ease, background .18s ease, transform .18s ease;
  }
  .subs a:hover {
    color: var(--accent);
    background: var(--accent-soft);
    transform: translateX(3px);
  }
  .subs .n { font-size: .7rem; color: var(--text-faint); font-variant-numeric: tabular-nums; }

  .empty { color: var(--text-muted); padding-block: 3rem; text-align: center; }

  @media (prefers-reduced-motion: reduce) {
    .cat:hover, .subs a:hover { transform: none; }
    .cat:hover .arrow { transform: none; }
    .arrow { transform: none; }
  }
</style>
