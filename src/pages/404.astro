---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="페이지를 찾을 수 없습니다">
  <div class="wrap center">
    <p class="code">404</p>
    <h1>페이지를 찾을 수 없습니다</h1>
    <p class="desc">주소가 바뀌었거나 삭제된 글일 수 있습니다.</p>
    <a href="/" class="home">
      홈으로
      <svg viewBox="0 0 16 16" width="14" height="14" aria-hidden="true">
        <path d="M3 8h9M8.4 4.2 12.2 8l-3.8 3.8" fill="none" stroke="currentColor"
              stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
      </svg>
    </a>
  </div>
</BaseLayout>

<style>
  .center { text-align: center; padding-block: 7rem 5rem; }
  .code {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 3rem;
    font-weight: 700;
    color: var(--text-faint);
  }
  h1 { margin: .5rem 0 0; font-size: 1.375rem; letter-spacing: -0.02em; }
  .desc { margin: .6rem 0 0; color: var(--text-muted); font-size: .9375rem; }
  .home {
    display: inline-flex;
    align-items: center;
    gap: .45rem;
    margin-top: 2rem;
    padding: .6rem 1.35rem;
    font-size: .9rem;
    font-weight: 600;
    color: var(--text);
    border: 1px solid var(--border-strong);
    border-radius: 999px;
    transition: background .22s ease, color .22s ease, border-color .22s ease, box-shadow .22s ease;
  }
  .home svg { transition: transform .25s cubic-bezier(.34, 1.3, .64, 1); }
  .home:hover {
    color: #fff;
    background: var(--accent);
    border-color: var(--accent);
    box-shadow: 0 4px 16px color-mix(in srgb, var(--accent) 30%, transparent);
  }
  .home:hover svg { transform: translateX(3px); }

  @media (prefers-reduced-motion: reduce) {
    .home:hover svg { transform: none; }
  }
</style>
