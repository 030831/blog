---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="페이지를 찾을 수 없습니다">
  <div class="wrap center">
    <p class="code">404</p>
    <h1>페이지를 찾을 수 없습니다</h1>
    <p class="desc">주소가 바뀌었거나 삭제된 글일 수 있습니다.</p>
    <a href="/" class="home">홈으로 →</a>
  </div>
</BaseLayout>

<style>
  .center { text-align: center; padding-block: 7rem 5rem; }
  .code {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 3rem;
    font-weight: 700;
    color: var(--text-faint);
  }
  h1 { margin: .5rem 0 0; font-size: 1.375rem; letter-spacing: -0.02em; }
  .desc { margin: .6rem 0 0; color: var(--text-muted); font-size: .9375rem; }
  .home {
    display: inline-block;
    margin-top: 2rem;
    color: var(--accent);
    font-size: .9375rem;
  }
  .home:hover { text-decoration: underline; text-underline-offset: 3px; }
</style>
