---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getTagCounts } from '../../lib/posts';

const tags = await getTagCounts();
---

<BaseLayout title="태그" description="주제별 글 모음">
  <div class="wrap">
    <header class="page-head">
      <h1>태그</h1>
      <p>{tags.length}개의 주제</p>
    </header>

    <ul class="tag-list">
      {tags.map(({ tag, count }) => (
        <li>
          <a href={`/tags/${encodeURIComponent(tag)}/`}>
            <span>#{tag}</span>
            <span class="count">{count}</span>
          </a>
        </li>
      ))}
    </ul>
  </div>
</BaseLayout>

<style>
  .page-head { padding-block: 3.5rem 2rem; }
  .page-head h1 { margin: 0; font-size: 1.875rem; font-weight: 800; letter-spacing: -0.03em; }
  .page-head p { margin: .5rem 0 0; color: var(--text-muted); font-size: .9375rem; }

  .tag-list {
    display: flex;
    flex-wrap: wrap;
    gap: .6rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .tag-list a {
    display: inline-flex;
    align-items: center;
    gap: .5rem;
    padding: .45rem .85rem;
    border: 1px solid var(--border);
    border-radius: 999px;
    font-size: .9375rem;
    transition: border-color .15s, color .15s, background .15s;
  }
  .tag-list a:hover { color: var(--accent); border-color: var(--accent); background: var(--accent-soft); }
  .count { font-size: .8125rem; color: var(--text-faint); }

  @media (prefers-reduced-motion: reduce) {
    .tag-list a:hover { transform: none; }
  }
</style>
