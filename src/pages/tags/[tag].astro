---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostRow from '../../components/PostRow.astro';
import SearchResults from '../../components/SearchResults.astro';
import { getPublishedPosts, getTagCounts } from '../../lib/posts';

export async function getStaticPaths() {
  const posts = await getPublishedPosts();
  const tags = await getTagCounts();
  return tags.map(({ tag }) => ({
    params: { tag },
    props: { tag, posts: posts.filter((p) => p.data.tags.includes(tag)) },
  }));
}

const { tag, posts } = Astro.props;
---

<BaseLayout title={`#${tag}`} description={`${tag} 태그가 붙은 글 ${posts.length}개`}>
  <div class="wrap">
    <header class="page-head">
      <a href="/tags" class="back">
        <svg viewBox="0 0 16 16" width="13" height="13" aria-hidden="true">
          <path d="M13 8H4M7.6 4.2 3.8 8l3.8 3.8" fill="none" stroke="currentColor"
                stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
        태그
      </a>
      <h1>#{tag}</h1>
      <p class="count">{posts.length}개의 글</p>
    </header>

    <SearchResults />

    <div id="post-list">
      <ul class="rows">
        {posts.map((post) => <PostRow post={post} />)}
      </ul>
    </div>
  </div>
</BaseLayout>

<style>
  .wrap { max-width: 46rem; padding-block: 2.75rem 1rem; }

  .page-head { margin-bottom: 1.75rem; }
  .back {
    display: inline-flex;
    align-items: center;
    gap: .35rem;
    font-size: .85rem;
    color: var(--text-muted);
    transition: color .18s ease;
  }
  .back svg { transition: transform .22s cubic-bezier(.34, 1.3, .64, 1); }
  .back:hover { color: var(--accent); }
  .back:hover svg { transform: translateX(-3px); }

  .page-head h1 {
    margin: .6rem 0 0;
    font-size: 1.9rem;
    font-weight: 800;
    letter-spacing: -0.03em;
  }
  .count { margin: .5rem 0 0; color: var(--text-muted); font-size: .9rem; }

  .rows {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--border-strong);
  }

  @media (prefers-reduced-motion: reduce) {
    .back:hover svg { transform: none; }
  }
</style>
