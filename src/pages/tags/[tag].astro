---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/PostCard.astro';
import { getPublishedPosts, getTagCounts } from '../../lib/posts';

export async function getStaticPaths() {
  const posts = await getPublishedPosts();
  const tags = await getTagCounts();
  return tags.map(({ tag }) => ({
    params: { tag },
    props: { tag, posts: posts.filter((p) => p.data.tags.includes(tag)) },
  }));
}

const { tag, posts } = Astro.props;
---

<BaseLayout title={`#${tag}`} description={`${tag} 태그가 붙은 글 ${posts.length}개`}>
  <div class="wrap">
    <header class="page-head">
      <a href="/tags" class="back">← 태그</a>
      <h1>#{tag}</h1>
      <p>{posts.length}개의 글</p>
    </header>

    {posts.map((post) => <PostCard post={post} />)}
  </div>
</BaseLayout>

<style>
  .page-head { padding-block: 3.5rem 1rem; }
  .back { font-size: .875rem; color: var(--text-muted); transition: color .15s; }
  .back:hover { color: var(--accent); }
  .page-head h1 { margin: .75rem 0 0; font-size: 1.875rem; font-weight: 800; letter-spacing: -0.03em; }
  .page-head p { margin: .5rem 0 0; color: var(--text-muted); font-size: .9375rem; }
</style>
