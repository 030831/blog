---
// 테마 시안 전용 껍데기.
// 시안마다 헤더/푸터 구조가 완전히 다르므로 공통 레이아웃을 쓰지 않고
// 각 시안이 페이지 전체를 직접 구성합니다.
import '../styles/global.css';

interface Props { title: string; }
const { title } = Astro.props;
---

<!doctype html>
<html lang="ko" data-skin="warm" data-theme="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  </head>
  <body>
    <a href="/themes/" class="back-to-themes">← 시안 목록</a>
    <slot />

    <style is:global>
      .back-to-themes {
        position: fixed;
        left: 1rem;
        bottom: 1rem;
        z-index: 100;
        padding: .5rem .9rem;
        font-family: var(--font-sans);
        font-size: .8125rem;
        font-weight: 600;
        color: #fff;
        background: #111;
        border-radius: 999px;
        box-shadow: 0 2px 12px rgb(0 0 0 / .25);
      }
      .back-to-themes:hover { background: #333; }
    </style>
  </body>
</html>
