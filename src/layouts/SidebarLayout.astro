---
// 카테고리 트리를 왼쪽에 두는 목록형 페이지 레이아웃.
import BaseLayout from './BaseLayout.astro';
import CategorySidebar from '../components/CategorySidebar.astro';

interface Props {
  title: string;
  description?: string;
  /** 사이드바에서 강조할 현재 카테고리 경로 */
  current?: string;
}
const { title, description, current = '' } = Astro.props;
---

<BaseLayout title={title} description={description}>
  <div class="shell">
    <CategorySidebar current={current} />
    <div class="content">
      <slot />
    </div>
  </div>
</BaseLayout>

<style>
  .shell {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
    max-width: 64rem;
    margin-inline: auto;
    padding: 2rem 1.5rem 0;
  }
  .content { min-width: 0; }

  @media (min-width: 60rem) {
    .shell {
      grid-template-columns: 15rem minmax(0, 1fr);
      gap: 3.5rem;
      padding-top: 3rem;
    }
  }
</style>
